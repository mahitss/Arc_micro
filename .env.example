# ==============================================================================
# AgentPay Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services locally.
# NEVER commit .env or live credentials/private keys to source control.
# ==============================================================================

# Arc Blockchain Configuration (Arc Mainnet - Chain ID 5042)
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_CHAIN_ID=5042
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_EXPLORER_URL=https://explorer.arc.io
ENABLE_LIVE_EXECUTION=false
ARC_RPC_TIMEOUT_MS=5000
ARC_CONFIRMATION_TIMEOUT_MS=60000

# Service Endpoints & Ports
GATEWAY_PORT=8080
POLICY_ENGINE_URL=http://localhost:8081
POLICY_ENGINE_PORT=8081
POLICY_ENGINE_TIMEOUT_MS=2000
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=1048576

# AI Agent & Payment Intent Configuration
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Database Configuration (PostgreSQL)
DATABASE_URL=

# Agent Execution & Expiration
AGENT_AUTO_EXECUTION=false
PAYMENT_INTENT_TTL_SECONDS=300

# Web Application
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
