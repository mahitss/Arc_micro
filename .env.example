# ==============================================================================
# AgentPay Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services locally.
# NEVER commit .env or live credentials/private keys to source control.
# ==============================================================================

# Arc Blockchain Configuration (Placeholders - to be configured in later deployment task)
# DO NOT insert guessed values; verified network constants will be configured upon deployment.
ARC_RPC_URL=
ARC_CHAIN_ID=
ARC_USDC_ADDRESS=

# Database Configuration (Future PostgreSQL persistence)
DATABASE_URL=

# Service Endpoints & Ports
GATEWAY_PORT=8080
POLICY_ENGINE_URL=http://localhost:8081
POLICY_ENGINE_PORT=8081
POLICY_ENGINE_TIMEOUT_MS=2000
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=1048576

# Web Application
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
