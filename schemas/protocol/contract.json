{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProtocolContract",
  "description": "Authoritative protocol contract governing multi-agent economic execution (INV-166, INV-171)",
  "type": "object",
  "required": [
    "contract_id",
    "tenant_id",
    "requester_id",
    "provider_id",
    "capability",
    "deliverables",
    "milestones",
    "state",
    "total_amount",
    "currency",
    "deadline",
    "escrow_required",
    "policy_snapshot_hash",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "requester_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "deliverables": {
      "type": "array",
      "items": { "type": "string" }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "milestone_id",
          "title",
          "deliverable_spec",
          "amount",
          "verification_method",
          "due_at",
          "status"
        ],
        "properties": {
          "milestone_id": { "type": "string" },
          "title": { "type": "string" },
          "deliverable_spec": { "type": "string" },
          "amount": { "type": "string" },
          "verification_method": { "type": "string" },
          "due_at": { "type": "string", "format": "date-time" },
          "status": {
            "type": "string",
            "enum": ["PENDING", "SUBMITTED", "VERIFIED", "PAID"]
          }
        }
      }
    },
    "state": {
      "type": "string",
      "enum": ["DRAFT", "PROPOSED", "NEGOTIATING", "ACTIVE", "DISPUTED", "SETTLED", "CANCELLED"]
    },
    "total_amount": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "enum": ["USDC"]
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "escrow_required": {
      "type": "boolean"
    },
    "escrow_id": {
      "type": "string"
    },
    "arbitrator_id": {
      "type": "string"
    },
    "policy_snapshot_hash": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
