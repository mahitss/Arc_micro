{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MatchExplanation",
  "description": "Structured explanation providing why a provider was selected by the Marketplace Matching Engine",
  "type": "object",
  "required": [
    "opportunity_id",
    "selected_provider_id",
    "capability_match",
    "deadline_feasibility",
    "policy_status",
    "risk_status",
    "quote_amount_usdc",
    "tie_break_reason"
  ],
  "properties": {
    "opportunity_id": { "type": "string" },
    "selected_provider_id": { "type": "string" },
    "selected_listing_id": { "type": "string" },
    "capability_match": { "type": "string", "enum": ["MATCH", "MISMATCH"] },
    "deadline_feasibility": { "type": "string", "enum": ["FEASIBLE", "INFEASIBLE"] },
    "policy_status": { "type": "string", "enum": ["ALLOWED", "REQUIRES_APPROVAL", "DENIED"] },
    "risk_status": { "type": "string", "enum": ["WITHIN_LIMIT", "ESCALATE", "DENIED"] },
    "availability_status": { "type": "string" },
    "quote_amount_usdc": { "type": "string" },
    "historical_success": { "type": "string" },
    "sample_size": { "type": "integer" },
    "tie_break_reason": { "type": "string" },
    "alternatives_rejected": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
