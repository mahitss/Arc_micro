{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["../../apps/web/node_modules/@types"],
    "paths": {
      "@agentpay/sdk": ["../../packages/sdk-typescript/dist/src/index.d.ts"]
    },
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
